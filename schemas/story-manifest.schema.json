                    "text": {
                      "type": "string"
                    },
                    "position": {
                      "default": "left",
                      "type": "string",
                      "enum": [
                        "left",
                        "center",
                        "right"
                      ]
                    }
                  },
                  "required": [
                    "speaker",
                    "text"
