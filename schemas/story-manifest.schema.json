              },
              "dialogue_text": {
                "default": "",
                "type": "string"
              },
              "avatar_position": {
                "default": "left",
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "lines": {
                "default": [],
