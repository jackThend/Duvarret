                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "additionalProperties": false
                },
                "room_preset": {
                  "type": "string",
                  "enum": [
                    "small_study",
                    "narrow_concrete_corridor",
                    "wooden_cabin",
                    "cathedral_echo",
                    "outdoor_field"
                  ]
                },
                "acoustic_material": {
                  "type": "string",
                  "enum": [
                    "wood",
                    "concrete",
                    "metal",
                    "curtains",
                    "glass",
                    "stone"
                  ]
                },
                "gain": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "fade_in_ms": {
                  "default": 0,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30000
                }
              },
              "required": [
                "event_id",
                "asset"
              ],
              "additionalProperties": false
            }
          },
          "visual_novel_overlay": {
            "type": "object",
            "properties": {
              "enabled": {
                "default": true,
                "type": "boolean"
              },
              "trigger": {
                "default": "on_text_complete",
                "type": "string",
                "enum": [
                  "on_node_enter",
                  "on_text_complete"
