              "on_failure": {
                "default": {
                  "grant_flags": [],
                  "revoke_flags": [],
                  "grant_items": [],
                  "consume_items": []
                },
                "type": "object",
                "properties": {
                  "grant_flags": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "revoke_flags": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "grant_items": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "consume_items": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "play_sfx": {
                    "type": "string"
                  },
                  "transition_to_node": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "rpg_checks": {
            "default": [],
