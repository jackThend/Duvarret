                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "consume_items": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "play_sfx": {
                    "type": "string"
                  },
                  "transition_to_node": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
